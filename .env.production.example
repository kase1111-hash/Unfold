# Unfold Production Environment Variables
# Copy this file to .env.production (gitignored), fill in SECURE values, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# POSTGRES_PASSWORD, NEO4J_PASSWORD and JWT_SECRET are required: compose
# refuses to start while they are empty, and the backend rejects placeholder
# values (anything containing "change") in production.

# PostgreSQL Database
POSTGRES_USER=unfold
# Required. Use URL-safe characters only (it is embedded in DATABASE_URL),
# e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=unfold

# Neo4j Graph Database (the admin user is always "neo4j")
# Required. Generate with: openssl rand -hex 24
NEO4J_PASSWORD=

# JWT Authentication
# Required, at least 32 characters. Generate with: openssl rand -hex 64
JWT_SECRET=

# Frontend API URL, inlined at build time. "/api/v1" is same-origin through
# the bundled nginx. Use an absolute URL (https://api.example.com/api/v1)
# only if the API is served from another host.
NEXT_PUBLIC_API_URL=/api/v1

# CORS Origins (your domain): comma-separated, a single URL, or a JSON list
CORS_ORIGINS=https://unfold.example.com,https://www.unfold.example.com

# AI Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External APIs (optional)
CROSSREF_EMAIL=admin@unfold.example.com
SEMANTIC_SCHOLAR_API_KEY=
