# Unfold Environment Variables (docker-compose.yml)
# Copy to .env and adjust values for your environment.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unfold

# Neo4j (the admin user is always "neo4j"; same default as backend/.env.example)
NEO4J_PASSWORD=changeme

# App
DEBUG=true
ENVIRONMENT=development
