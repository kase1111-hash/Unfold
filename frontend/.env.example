# Unfold Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API Configuration
# Backend base URL. "/api/v1" is appended when missing, so
# http://localhost:8000 and http://localhost:8000/api/v1 are equivalent.
# Inlined at build time (NEXT_PUBLIC_*): rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Application
NEXT_PUBLIC_APP_NAME=Unfold
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SCHOLAR_MODE=true

# Development
NEXT_TELEMETRY_DISABLED=1
